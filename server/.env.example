NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/x
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Browser/session security. Generate a unique COOKIE_SECRET of at least 32 characters.
APP_ORIGIN=http://localhost:3000
COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_DAYS=30
OAUTH_FLOW_TTL_MINUTES=10

# Google OAuth (optional until credentials are created)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback

# Facebook OAuth (optional until credentials are created)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/auth/oauth/facebook/callback
