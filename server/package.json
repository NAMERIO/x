{
  "name": "@x/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/health.test.mjs test/password.test.mjs",
    "db:generate": "pnpm --filter @x/shared build && drizzle-kit generate --config=src/database/drizzle.config.ts",
    "db:migrate": "pnpm --filter @x/shared build && drizzle-kit migrate --config=src/database/drizzle.config.ts",
    "db:studio": "pnpm --filter @x/shared build && drizzle-kit studio --config=src/database/drizzle.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@x/shared": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.7.4",
    "pg": "^8.22.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
